; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="BlockPuzzle"
config/description="Головоломка с блоками: поле 8×8, без рекламы и без интернета."
config/version="0.1.0"
run/main_scene="uid://rv4fddmg0qlx"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.063, 0.188, 1)
boot_splash/image="res://assets/icon/icon_192.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"

run/low_processor_mode=true
config/quit_on_go_back=false

[autoload]

ItemsDB="*res://autoload/items_db.gd"
Events="*res://autoload/events.gd"
GameSettings="*res://autoload/game_settings.gd"
Sfx="*res://autoload/sfx.gd"
ThemeManager="*res://autoload/theme_manager.gd"
Progression="*res://autoload/progression.gd"
Achievements="*res://autoload/achievements.gd"
Missions="*res://autoload/missions.gd"

[display]

window/size/viewport_width=900
window/size/viewport_height=1600
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/ui_theme.tres"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
